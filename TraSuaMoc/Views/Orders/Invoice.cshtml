@model TraSuaMoc.Models.Order
@{ ViewBag.Title = "Hóa đơn MOC-" + Model.Id.ToString("D6"); }
<section class="container invoice-section"><div class="invoice-success"><span class="success-mark">✓</span><p class="eyebrow">THÊM MỘT NGÀY NGỌT NGÀO</p><h1>Cảm ơn bạn đã chọn Mộc!</h1><p>Đơn hàng của bạn đã được ghi nhận. Hẹn bạn ở những vị trà tiếp theo.</p></div><article class="invoice-paper"><div class="invoice-top"><div><span class="brand">mộc</span><h2>Hóa đơn thanh toán</h2></div><span class="paid-badge">@Model.PaymentStatus</span></div><div class="invoice-meta"><div><span>MÃ HÓA ĐƠN</span><strong>MOC-@Model.Id.ToString("D6")</strong></div><div><span>KHÁCH HÀNG</span><strong>@Model.CustomerName</strong></div><div><span>THỜI GIAN (VIỆT NAM)</span><strong>@Model.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</strong></div></div><div class="table-scroll"><table class="invoice-table"><thead><tr><th>Sản phẩm</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th></tr></thead><tbody>@foreach (var line in Model.Details.OrderBy(x => x.Id)) { <tr><td>@line.ProductName</td><td>@line.UnitPrice.ToString("N0") đ</td><td>@line.Quantity</td><td>@((line.UnitPrice * line.Quantity).ToString("N0")) đ</td></tr> }</tbody></table></div><div class="invoice-total"><span>Tổng tiền thanh toán</span><strong>@Model.Total.ToString("N0") đ</strong></div><p class="invoice-note">Hóa đơn mô phỏng phục vụ học tập, không phải hóa đơn thuế và không xác nhận giao dịch tiền thật.</p></article><div class="invoice-actions"><a class="button" href="@Url.Action("Index", "Products")">Tiếp tục chọn món ↗</a><button class="button button-outline" type="button" data-print>In hóa đơn</button><a class="underlined-link" href="@Url.Action("Index")">Xem đơn của bạn</a></div></section>
