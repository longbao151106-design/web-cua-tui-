@model List<TraSuaMoc.Models.Order>
@{ ViewBag.Title = "Đơn của bạn"; }
<section class="container section"><p class="eyebrow">NHỮNG LẦN GHÉ MỘC</p><h1>Đơn hàng của bạn.</h1><p class="result-count">@Model.Count đơn hàng · Tổng đã thanh toán mô phỏng: @(((decimal)ViewBag.TotalSpent).ToString("N0")) đ</p>@if (Model.Count == 0) { <div class="empty-state"><span class="empty-icon">❧</span><h2>Chưa có đơn hàng nào.</h2><p>Vị trà đầu tiên đang chờ bạn trong thực đơn.</p><a class="button" href="@Url.Action("Index", "Products")">Chọn món ngay ↗</a></div> } else { <div class="table-scroll order-history"><table class="invoice-table"><thead><tr><th>Mã hóa đơn</th><th>Thời gian (Việt Nam)</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var order in Model) { <tr><td>MOC-@order.Id.ToString("D6")</td><td>@order.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</td><td>@order.Total.ToString("N0") đ</td><td>@order.PaymentStatus</td><td><a class="underlined-link" href="@Url.Action("Invoice", new { id = order.Id })">Xem hóa đơn ↗</a></td></tr> }</tbody></table></div> }</section>
