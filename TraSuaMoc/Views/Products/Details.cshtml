@model TraSuaMoc.Models.Product
@{ ViewBag.Title = Model.Name; }
<div class="container"><nav class="breadcrumbs" aria-label="Đường dẫn"><a href="@Url.Action("Index", "Home")">Trang chủ</a><span>/</span><a href="@Url.Action("Index")">Thực đơn</a><span>/</span><span>@Model.Name</span></nav>
<section class="detail-grid"><div class="detail-art">@Html.Partial("_ProductPhoto", Model.Color)@if (!string.IsNullOrEmpty(Model.Badge)) { <span class="badge">@Model.Badge</span> }</div><div class="detail-copy"><p class="eyebrow">@Model.Category.Name · MỘC TRÀ SỮA</p><h1>@Model.Name</h1><p class="detail-price">@Model.Price.ToString("N0") <small>đ</small></p><p class="description">@Model.Description</p><div class="detail-specs"><span>❧ Pha mới khi đặt</span><span>◌ Ly 500 ml</span></div>
@using (Html.BeginForm("Add", "Cart", FormMethod.Post, new { @class = "add-form" })) { @Html.AntiForgeryToken()<input type="hidden" name="productId" value="@Model.Id" /><label for="quantity">Số lượng</label><div class="add-actions"><div class="quantity-control"><button type="button" data-step="-1" aria-label="Giảm số lượng">−</button><input id="quantity" name="quantity" type="number" value="1" min="1" max="20" required /><button type="button" data-step="1" aria-label="Tăng số lượng">+</button></div><button class="button" type="submit">Thêm vào giỏ <span>+</span></button></div> }
<a class="underlined-link" href="@Url.Action("Index", "Cart")">Xem giỏ hàng của bạn ↗</a><p class="detail-footnote">Chọn món, thêm vào giỏ và hoàn tất đơn hàng chỉ trong vài bước.</p></div></section></div>
