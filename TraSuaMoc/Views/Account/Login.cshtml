@model TraSuaMoc.Models.LoginViewModel
@{ ViewBag.Title = "Đăng nhập"; }
<section class="container login-section"><div class="login-story"><span class="eyebrow">MỘC CHỜ BẠN</span><h1>Vị trà thân quen.<br /><em>Niềm vui trở lại.</em></h1><div class="login-art">@Html.Partial("_ProductPhoto", "oolong")</div><p>Một lần ghé, thêm một chút thương.</p></div><div class="login-panel"><p class="eyebrow">CHÀO MỪNG BẠN ĐẾN VỚI MỘC</p><h2>Đăng nhập</h2><p>Đăng nhập để hoàn tất đơn hàng và xem lại những ly trà đã chọn.</p>
@using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "login-form" })) { @Html.AntiForgeryToken() @Html.HiddenFor(x => x.ReturnUrl) @Html.ValidationSummary(true, "", new { @class = "validation-summary", role = "alert" })<label for="Email">Email</label>@Html.TextBoxFor(x => x.Email, new { type = "email", placeholder = "ban@email.com", autocomplete = "username", required = "required", maxlength = "150" }) @Html.ValidationMessageFor(x => x.Email)<label for="Password">Mật khẩu</label><div class="password-field">@Html.PasswordFor(x => x.Password, new { placeholder = "Nhập mật khẩu của bạn", autocomplete = "current-password", required = "required", maxlength = "200" })<button type="button" data-toggle-password aria-label="Hiện mật khẩu" aria-pressed="false">Hiện</button></div>@Html.ValidationMessageFor(x => x.Password)<button class="button full-width" type="submit">Đăng nhập <span>↗</span></button> }
<div class="demo-account"><strong>Tài khoản trải nghiệm</strong><span>Email: demo@@trasuamoc.vn</span><span>Mật khẩu: TraSua@@123</span><small>Tài khoản dùng chung chỉ để thử chức năng. Không nhập thông tin cá nhân.</small></div><a class="underlined-link" href="@Url.Action("Index", "Products")">Tiếp tục xem thực đơn ↗</a></div></section>
