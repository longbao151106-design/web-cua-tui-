@model TraSuaMoc.Models.CartViewModel
@{ ViewBag.Title = "Giỏ hàng"; }
<section class="container cart-section"><nav class="breadcrumbs" aria-label="Đường dẫn"><a href="@Url.Action("Index", "Products")">Thực đơn</a><span>/</span><span>Giỏ hàng</span></nav><div class="section-heading"><div><p class="eyebrow">NHỮNG VỊ TRÀ BẠN CHỌN</p><h1>Giỏ hàng của bạn.</h1></div><span class="steps"><strong>01 Giỏ hàng</strong><span>—</span>02 Hóa đơn</span></div>
@if (Model.Lines.Count == 0) { <div class="empty-state"><span class="empty-icon">♧</span><h2>Giỏ hàng đang đợi một ly trà.</h2><p>Ghé thực đơn và mang về một chút ngọt ngào nhé.</p><a class="button" href="@Url.Action("Index", "Products")">Khám phá thực đơn ↗</a></div> }
else {
<div class="cart-grid"><div><div class="cart-table-heading"><span>Món bạn chọn</span><span>Thành tiền</span></div>@foreach (var line in Model.Lines) { <article class="cart-row"><a class="cart-thumb" href="@Url.Action("Details", "Products", new { id = line.Product.Id })">@Html.Partial("_ProductPhoto", line.Product.Color)</a><div class="cart-row-info"><p class="eyebrow">@line.Product.Category.Name</p><h3><a href="@Url.Action("Details", "Products", new { id = line.Product.Id })">@line.Product.Name</a></h3><p class="unit-price">@line.Product.Price.ToString("N0") đ / ly</p><div class="cart-controls">@using (Html.BeginForm("Update", "Cart", FormMethod.Post, new { @class = "quantity-form" })) { @Html.AntiForgeryToken()<input type="hidden" name="productId" value="@line.Product.Id" /><label class="sr-only" for="quantity-@line.Product.Id">Số lượng @line.Product.Name</label><input id="quantity-@line.Product.Id" type="number" name="quantity" min="1" max="20" value="@line.Quantity" required /><button type="submit" class="text-button">Cập nhật</button> } @using (Html.BeginForm("Remove", "Cart", FormMethod.Post)) { @Html.AntiForgeryToken()<input type="hidden" name="productId" value="@line.Product.Id" /><button type="submit" class="remove-button" aria-label="Gỡ bỏ @line.Product.Name">Gỡ bỏ</button> }</div></div><strong class="line-total">@line.Subtotal.ToString("N0") đ</strong></article> }<a class="underlined-link back-menu" href="@Url.Action("Index", "Products")">← Chọn thêm món</a></div>
<aside class="order-summary"><p class="eyebrow">MỘT CHÚT NGỌT NGÀO</p><h2>Tóm tắt đơn hàng</h2><div class="summary-line"><span>Tạm tính (@Model.Lines.Sum(x => x.Quantity) ly)</span><span>@Model.Total.ToString("N0") đ</span></div><div class="summary-line"><span>Phụ phí</span><span>0 đ</span></div><div class="summary-total"><span>Tổng thanh toán</span><strong>@Model.Total.ToString("N0") đ</strong></div><p class="checkout-note">Thanh toán mô phỏng cho bài thực hành. Không thu tiền thực tế.</p>
@if (User.Identity.IsAuthenticated) { using (Html.BeginForm("Checkout", "Cart", FormMethod.Post, new { data_checkout = "true" })) { @Html.AntiForgeryToken()<input type="hidden" name="checkoutToken" value="@Model.CheckoutToken" /><button class="button full-width" type="submit">Thanh toán &amp; tạo hóa đơn ↗</button> } }
else { <a class="button full-width" href="@Url.Action("Login", "Account", new { returnUrl = Url.Action("Index", "Cart") })">Đăng nhập để thanh toán ↗</a><p class="helper-text">Giỏ hàng được giữ lại khi bạn đăng nhập.</p> }
<p class="summary-bottom">❧ Mộc cảm ơn vì đã chọn chúng mình.</p></aside></div>
}
</section>
